{
  "name": "tactique-tiktok",
  "version": "1.0.0",
  "private": true,
  "description": "Générateur Remotion de vidéos d'analyse tactique foot (style tableau tactique néon, 1080x1920 @60fps)",
  "scripts": {
    "start": "remotion studio",
    "studio": "remotion studio",
    "render": "remotion render TactiqueDemo out/tactique-demo.mp4",
    "still": "remotion still TactiqueDemo out/still.png --frame=600",
    "typecheck": "tsc --noEmit",
    "voiceover": "NODE_USE_ENV_PROXY=1 tsx scripts/voiceover.ts",
    "build": "npm run voiceover && npm run render"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@remotion/cli": "4.0.544",
    "@remotion/fonts": "4.0.544",
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "4.0.544"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
