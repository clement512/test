{
  "name": "smart-short",
  "version": "1.0.0",
  "private": true,
  "description": "Générateur Remotion des mini-documentaires SMART SHORT (vertical 1080x1920, sombre et doré)",
  "scripts": {
    "studio": "remotion studio",
    "voice": "NODE_USE_ENV_PROXY=1 tsx scripts/voice.ts",
    "typecheck": "tsc --noEmit",
    "render:ep4": "remotion render Ep04Gerrymandering out/ep04-gerrymandering.mp4",
    "render:ep5": "remotion render Ep05Islande out/ep05-islande.mp4",
    "render:ep6": "remotion render Ep06Napoleon out/ep06-napoleon.mp4"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@fontsource/anton": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@remotion/cli": "^4.0.544",
    "@remotion/fonts": "^4.0.544",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.544"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
